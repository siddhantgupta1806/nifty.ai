# ── OpenAlgo ─────────────────────────────────────────────────────────────────
OPENALGO_API_KEY=replace_me
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_WS=ws://127.0.0.1:8765
# Optional MCP server URL (stdio is auto-detected; set for HTTP/SSE transport)
OPENALGO_MCP_URL=

# ── LLM providers (pick at least one) ────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Default provider for TradingAgents (openai | anthropic | google | ollama | ...)
NIFTY_AI_LLM_PROVIDER=openai
NIFTY_AI_DEEP_LLM=gpt-5.4
NIFTY_AI_QUICK_LLM=gpt-5.4-mini

# ── Storage paths ────────────────────────────────────────────────────────────
NIFTY_AI_DB_PATH=./.nifty_ai/nifty.duckdb
NIFTY_AI_CACHE_DIR=./.nifty_ai/cache
NIFTY_AI_LOG_DIR=./.nifty_ai/logs
NIFTY_AI_RESULTS_DIR=./.nifty_ai/results

# ── Cost guardrails ──────────────────────────────────────────────────────────
NIFTY_AI_MAX_LLM_CALLS_PER_RUN=2000
